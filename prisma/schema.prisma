// =================================================================
// SocialFlow AI Studio — Prisma Schema
// Multi-tenant, multi-brand, multi-account SaaS
// =================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =================================================================
// ENUMS
// =================================================================

enum UserRole {
  SUPER_ADMIN
  OWNER
  ADMIN
  STRATEGIST
  DESIGNER
  EDITOR
  CLIENT
  VIEWER
}

enum OrgPlan {
  FREE
  PRO
  AGENCY
  ENTERPRISE
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  TWITTER
  TIKTOK
  YOUTUBE
  PINTEREST
  WHATSAPP
  EMAIL
}

enum SocialAccountType {
  PROFILE
  PAGE
  BUSINESS
  CHANNEL
  GROUP
}

enum SocialAccountStatus {
  NOT_CONFIGURED
  CONNECTING
  CONNECTED
  PERMISSION_MISSING
  TOKEN_EXPIRED
  DEGRADED
  DISCONNECTED
  EXPIRED // deprecated — use TOKEN_EXPIRED
  ERROR
  PENDING
}

enum PostStatus {
  IDEA
  DRAFT
  AI_GENERATED
  IN_DESIGN
  DESIGN_LINKED
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  QUEUED
  PUBLISHING
  UPLOADING
  PROCESSING
  PUBLISHED
  SIMULATED
  FAILED
  ACTION_REQUIRED
  MANUAL_SHARE_REQUIRED
  ARCHIVED
}

enum SupportFormat {
  // Social
  INSTAGRAM_POST
  INSTAGRAM_STORY
  INSTAGRAM_REEL
  INSTAGRAM_CAROUSEL
  FACEBOOK_POST
  FACEBOOK_STORY
  LINKEDIN_POST
  LINKEDIN_ARTICLE
  TWITTER_POST
  TWITTER_THREAD
  TIKTOK_VIDEO
  YOUTUBE_SHORT
  YOUTUBE_THUMBNAIL
  PINTEREST_PIN
  // Marketing
  WEB_BANNER
  AD_VISUAL
  FLYER
  POSTER
  PRESENTATION
  EDUCATIONAL_CAROUSEL
  PRODUCT_SHEET
  NEWSLETTER
  EMAIL_MARKETING
  LANDING_COPY
  VIDEO_SCRIPT
  STORYBOARD
  VOICEOVER
  EDITORIAL_CALENDAR
  CREATIVE_BRIEF
  CAMPAIGN_GUIDE
  MEDIA_KIT
  PRESS_KIT
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum AutomationStatus {
  ACTIVE
  PAUSED
  DRAFT
  ARCHIVED
}

enum AutomationTriggerType {
  DATE
  FREQUENCY
  NEW_TREND
  NEW_PRODUCT
  NEW_RSS_ITEM
  NEW_COMPETITOR_POST
  NEW_KEYWORD_HIT
  POST_FAILED
  POST_APPROVED
  HIGH_PERFORMANCE_POST
}

enum AutomationActionType {
  GENERATE_POST
  GENERATE_IMAGE
  GENERATE_CANVA_BRIEF
  CREATE_DRAFT
  REQUEST_APPROVAL
  SCHEDULE_POST
  PUBLISH_POST
  TRANSLATE
  CREATE_AB_VARIANT
  SEND_NOTIFICATION
  CREATE_REPORT
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum TrendWatchKind {
  TREND
  KEYWORD
  HASHTAG
  RSS
  COMPETITOR
  PRODUCT
  GOOGLE_TRENDS
  TIKTOK_TRENDS
  REDDIT
  YOUTUBE
}

enum ApprovalStatus {
  PENDING
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum NotificationType {
  POST_APPROVED
  POST_REJECTED
  POST_PUBLISHED
  POST_FAILED
  TREND_DETECTED
  COMPETITOR_ALERT
  AUTOMATION_FAILED
  TOKEN_EXPIRING
  APPROVAL_REQUESTED
  COMMENT_ADDED
  SYSTEM
}

enum AIProviderKind {
  OPENAI
  ANTHROPIC
  GOOGLE_GEMINI
  REPLICATE
  STABILITY
  MOCK
}

enum AIRequestType {
  TEXT
  IMAGE
  VIDEO
  EMBEDDING
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  CANVA_LINK
}

enum InteractionType {
  COMMENT
  DM
  MENTION
  REPLY
  REACTION
}

enum InteractionStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
  AUTO_REPLIED
  IGNORED
}

enum InteractionSentiment {
  POSITIVE
  NEGATIVE
  NEUTRAL
  SPAM
  UNKNOWN
}

enum MentionSource {
  TWITTER
  REDDIT
  WEB
  NEWS
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  YOUTUBE
  BLOG
  FORUM
  OTHER
}

enum MentionSentiment {
  POSITIVE
  NEGATIVE
  NEUTRAL
  MIXED
  UNKNOWN
}

enum MentionStatus {
  NEW
  REVIEWED
  RESPONDED
  IGNORED
}

enum AlertType {
  NEGATIVE_MENTION
  VOLUME_SPIKE
  INFLUENCER_MENTION
  KEYWORD_MATCH
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

// =================================================================
// TENANCY — Users, Organizations, Teams
// =================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  locale        String    @default("fr")
  globalRole    UserRole  @default(OWNER)
  disabled      Boolean   @default(false)

  accounts                     Account[]
  sessions                     Session[]
  memberships                  TeamMember[]
  createdPosts                 Post[]              @relation("PostAuthor")
  aiRequests                   AIRequest[]
  notifications                Notification[]
  comments                     ApprovalComment[]
  auditLogs                    AuditLog[]
  invitesSent                  TeamInvite[]        @relation("InviteSender")
  agentRuns                    AgentRun[]
  strategiesValidated          MarketingStrategy[] @relation("StrategyValidator")
  startedPipelineRuns          BrandPipelineRun[]  @relation("BrandPipelineStarter")
  approvedProfilePipelineRuns  BrandPipelineRun[]  @relation("BrandPipelineProfileApprover")
  approvedStrategyPipelineRuns BrandPipelineRun[]  @relation("BrandPipelineStrategyApprover")
  interactionsAssigned         SocialInteraction[] @relation("InteractionAssignee")
  interactionsReplied          SocialInteraction[] @relation("InteractionReplier")
  createdReports               Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// NextAuth tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  plan     OrgPlan @default(FREE)
  logo     String?
  settings Json    @default("{}")

  members         TeamMember[]
  invites         TeamInvite[]
  agentRuns       AgentRun[]
  agentPolicy     AgentPolicy?
  aiModelPrefs    AIModelPreference[]
  integrations    UserIntegration[]
  strategies      MarketingStrategy[]
  brands          Brand[]
  clients         Client[]
  socialAccounts  SocialAccount[]
  posts           Post[]
  campaigns       Campaign[]
  automations     Automation[]
  contentFlows    ContentFlow[]
  trendWatches    TrendWatch[]
  competitors     Competitor[]
  mediaAssets     MediaAsset[]
  canvaDesigns    CanvaDesign[]
  aiRequests      AIRequest[]
  notifications   Notification[]
  subscription    Subscription?
  apiLogs         ApiLog[]
  errorLogs       ErrorLog[]
  auditLogs       AuditLog[]
  analytics       AnalyticsSnapshot[]
  approvals       ApprovalRequest[]
  pipelineRuns    BrandPipelineRun[]
  interactions    SocialInteraction[]
  autoReplyRules  AutoReplyRule[]
  reports         Report[]
  reportSchedules ReportSchedule[]
  mentionWatches  MentionWatch[]
  brandMentions   BrandMention[]
  mentionAlerts   MentionAlert[]
  outreaches      OutreachCampaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  role           UserRole  @default(EDITOR)
  invitedEmail   String?
  acceptedAt     DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Client {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  contactEmail   String?
  notes          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brands       Brand[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// =================================================================
// BRANDS
// =================================================================

model Brand {
  id             String  @id @default(cuid())
  organizationId String
  clientId       String?
  name           String
  slug           String
  logo           String?
  industry       String?
  description    String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  profile      BrandProfile?

  socialAccounts  SocialAccount[]
  posts           Post[]
  campaigns       Campaign[]
  trendWatches    TrendWatch[]
  competitors     Competitor[]
  canvaDesigns    CanvaDesign[]
  canvaTemplates  CanvaTemplate[]
  mediaAssets     MediaAsset[]
  automations     Automation[]
  contentFlows    ContentFlow[]
  strategies      MarketingStrategy[]
  pipelineRuns    BrandPipelineRun[]
  interactions    SocialInteraction[]
  autoReplyRules  AutoReplyRule[]
  reports         Report[]
  reportSchedules ReportSchedule[]
  mentionWatches  MentionWatch[]
  brandMentions   BrandMention[]
  mentionAlerts   MentionAlert[]
  outreaches      OutreachCampaign[]
  integrations    UserIntegration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([clientId])
}

model BrandProfile {
  id      String @id @default(cuid())
  brandId String @unique

  slogan             String?
  mission            String?
  values             String[]
  audienceTarget     String?
  productsServices   String[]
  toneOfVoice        String?
  wordsToUse         String[]
  wordsToAvoid       String[]
  officialHashtags   String[]
  primaryColor       String?
  secondaryColor     String?
  accentColor        String?
  typography         String?
  importantLinks     Json     @default("[]")
  successfulExamples Json     @default("[]")
  forbiddenExamples  Json     @default("[]")
  visualStyle        String?
  canvaStyle         String?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =================================================================
// SOCIAL ACCOUNTS
// =================================================================

model SocialAccount {
  id             String              @id @default(cuid())
  organizationId String
  brandId        String?
  platform       SocialPlatform
  type           SocialAccountType   @default(PROFILE)
  externalId     String
  handle         String
  displayName    String
  avatarUrl      String?
  status         SocialAccountStatus @default(PENDING)
  permissions    String[]
  metadata       Json                @default("{}")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  tokens       SocialToken[]
  pages        SocialPage[]
  schedules    PostSchedule[]
  analytics    PostAnalytics[]
  apiLogs      ApiLog[]
  interactions SocialInteraction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, externalId])
  @@index([organizationId])
  @@index([brandId])
}

model SocialToken {
  id              String    @id @default(cuid())
  socialAccountId String
  // Encrypted at rest (AES-256-GCM) — see lib/encryption.ts
  accessTokenEnc  String    @db.Text
  refreshTokenEnc String?   @db.Text
  scope           String?
  expiresAt       DateTime?
  rotatedAt       DateTime?

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([socialAccountId])
}

model SocialPage {
  id              String         @id @default(cuid())
  socialAccountId String
  platform        SocialPlatform
  externalId      String
  name            String
  avatarUrl       String?
  category        String?
  metadata        Json           @default("{}")

  socialAccount SocialAccount  @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  schedules     PostSchedule[]

  @@unique([platform, externalId])
  @@index([socialAccountId])
}

model PlatformPermission {
  id          String         @id @default(cuid())
  platform    SocialPlatform
  scope       String
  description String
  required    Boolean        @default(false)

  @@unique([platform, scope])
}

// =================================================================
// CONTENT — Posts, Variants, Schedules, Media
// =================================================================

model Post {
  id             String        @id @default(cuid())
  organizationId String
  brandId        String?
  campaignId     String?
  authorId       String?
  status         PostStatus    @default(DRAFT)
  format         SupportFormat
  language       String        @default("fr")
  title          String?
  body           String?       @db.Text
  hashtags       String[]
  cta            String?
  linkUrl        String?
  productRef     String?
  aiPrompt       String?       @db.Text
  aiProvider     String?
  aiModel        String?
  version        Int           @default(1)
  metadata       Json          @default("{}")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  author       User?        @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  variants     PostVariant[]
  versions     PostVersion[]
  schedules    PostSchedule[]
  media        MediaAsset[]        @relation("PostMedia")
  canvaDesigns CanvaDesign[]
  analytics    PostAnalytics[]
  approvals    ApprovalRequest[]
  interactions SocialInteraction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([brandId])
  @@index([campaignId])
  @@index([authorId])
}

model PostVariant {
  id       String   @id @default(cuid())
  postId   String
  label    String // "A", "B", "tone:friendly", etc.
  body     String?  @db.Text
  hashtags String[]
  cta      String?
  /// Plateforme ciblée quand la variante est spécifique à un réseau
  platform String?
  /// Provider IA ayant produit la variante + mode (jamais un mock présenté comme réel)
  provider String?
  mocked   Boolean  @default(false)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

/// Instantané du contenu d'un post à chaque modification — historique
/// consultable et restaurable depuis l'atelier.
model PostVersion {
  id          String   @id @default(cuid())
  postId      String
  version     Int
  title       String?
  body        String?  @db.Text
  hashtags    String[]
  cta         String?
  note        String? // "edit" | "restore v3" | "variant B appliquée" ...
  createdById String?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, version])
  @@index([postId])
}

model PostSchedule {
  id              String     @id @default(cuid())
  postId          String
  socialAccountId String?
  socialPageId    String?
  scheduledFor    DateTime
  publishedAt     DateTime?
  status          PostStatus @default(SCHEDULED)
  externalPostId  String?
  errorMessage    String?    @db.Text
  attempts        Int        @default(0)
  shareMode       String?    @default("AUTO")
  manualSharedAt  DateTime?
  googleEventId   String?

  post            Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount?   @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  socialPage      SocialPage?      @relation(fields: [socialPageId], references: [id], onDelete: SetNull)
  analytics       PostAnalytics?
  publishAttempts PublishAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([socialAccountId])
  @@index([scheduledFor])
}

/// Journal exhaustif de chaque tentative de publication — la source de vérité
/// pour l'audit : qui a appelé quoi, avec quel résultat, en mode réel ou simulé.
model PublishAttempt {
  id             String         @id @default(cuid())
  scheduleId     String
  organizationId String?
  platform       SocialPlatform
  /// 'native' | 'manual' | 'simulation' (plus tard: 'late' | 'ayrshare')
  provider       String
  /// 'REAL' | 'SIMULATED'
  mode           String
  attempt        Int
  idempotencyKey String         @unique
  requestId      String
  externalPostId String?
  externalUrl    String?
  /// Réponse normalisée (jamais de token dedans)
  response       Json?
  errorCode      String?
  errorMessage   String?        @db.Text
  startedAt      DateTime       @default(now())
  finishedAt     DateTime?

  schedule PostSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@index([requestId])
  @@index([organizationId, startedAt])
}

model MediaAsset {
  id             String    @id @default(cuid())
  organizationId String
  brandId        String?
  kind           MediaKind
  url            String
  thumbnailUrl   String?
  mimeType       String?
  sizeBytes      Int?
  width          Int?
  height         Int?
  durationSec    Int?
  altText        String?
  source         String? // "upload" | "ai" | "canva" | "stock"
  externalRef    String?
  metadata       Json      @default("{}")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  posts        Post[]       @relation("PostMedia")

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([brandId])
}

// =================================================================
// CANVA
// =================================================================

model CanvaDesign {
  id             String  @id @default(cuid())
  organizationId String
  brandId        String?
  postId         String?
  templateId     String?
  canvaDesignId  String? // Canva API external id
  canvaUrl       String
  previewUrl     String?
  exportUrl      String?
  format         String?
  metadata       Json    @default("{}")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  post         Post?          @relation(fields: [postId], references: [id], onDelete: SetNull)
  template     CanvaTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([postId])
}

model CanvaTemplate {
  id          String  @id @default(cuid())
  brandId     String
  name        String
  canvaUrl    String
  previewUrl  String?
  format      String?
  description String?
  /// Identifiant Canva Brand Template (ex: "DAF...") — requis pour l'Autofill
  /// API réel (mode CANVA_API). Sans lui: mode HANDOFF.
  brandTemplateId String?

  brand   Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  designs CanvaDesign[]

  createdAt DateTime @default(now())

  @@index([brandId])
}

// =================================================================
// CAMPAIGNS
// =================================================================

model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  brandId        String?
  name           String
  slug           String
  objective      String?
  status         CampaignStatus @default(DRAFT)
  startsAt       DateTime?
  endsAt         DateTime?
  budgetCents    Int?
  targetAudience String?
  metadata       Json           @default("{}")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  posts        Post[]
  events       CalendarEvent[]
  analytics    CampaignAnalytics[]
  outreaches   OutreachCampaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([brandId])
}

// =================================================================
// OUTREACH — campagnes d'emailing et de messagerie des réseaux
// =================================================================

enum OutreachChannel {
  EMAIL
  SOCIAL_DM
}

enum OutreachCampaignStatus {
  DRAFT
  SENDING
  SENT
  PARTIAL
  FAILED
}

enum OutreachRecipientStatus {
  PENDING
  SENT
  SIMULATED
  FAILED
  SKIPPED
}

model OutreachCampaign {
  id             String                 @id @default(cuid())
  organizationId String
  brandId        String?
  campaignId     String?
  channel        OutreachChannel
  platform       SocialPlatform?
  name           String
  subject        String?
  body           String                 @db.Text
  // Pièces jointes (canal EMAIL) : [{name, url, mimeType?, sizeBytes?}].
  attachments    Json                   @default("[]")
  status         OutreachCampaignStatus @default(DRAFT)
  sentAt         DateTime?
  createdById    String?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  campaign     Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  recipients   OutreachRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([brandId])
}

model OutreachRecipient {
  id            String                  @id @default(cuid())
  outreachId    String
  email         String?
  handle        String?
  name          String?
  // SOCIAL_DM : interaction inbox à laquelle on répond (seul canal d'envoi réel).
  interactionId String?
  status        OutreachRecipientStatus @default(PENDING)
  detail        String?
  sentAt        DateTime?

  outreach OutreachCampaign @relation(fields: [outreachId], references: [id], onDelete: Cascade)

  @@index([outreachId])
}

model CalendarEvent {
  id          String    @id @default(cuid())
  campaignId  String?
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  color       String?
  metadata    Json      @default("{}")

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([startsAt])
}

// =================================================================
// AUTOMATION
// =================================================================

model Automation {
  id             String                @id @default(cuid())
  organizationId String
  brandId        String?
  name           String
  description    String?
  status         AutomationStatus      @default(DRAFT)
  triggerType    AutomationTriggerType
  triggerConfig  Json                  @default("{}")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  steps        AutomationStep[]
  runs         AutomationRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([brandId])
}

model AutomationStep {
  id           String               @id @default(cuid())
  automationId String
  order        Int
  actionType   AutomationActionType
  config       Json                 @default("{}")

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
}

model AutomationRun {
  id           String              @id @default(cuid())
  automationId String
  status       AutomationRunStatus @default(PENDING)
  startedAt    DateTime?
  finishedAt   DateTime?
  input        Json                @default("{}")
  output       Json                @default("{}")
  errorMessage String?             @db.Text

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([automationId, status])
}

// =================================================================
// MARKETING INTELLIGENCE / WATCH
// =================================================================

model TrendWatch {
  id             String          @id @default(cuid())
  organizationId String
  brandId        String?
  kind           TrendWatchKind
  name           String
