// =================================================================
// AGENT (Claude assistant + autonomous operator + dev agent)
// =================================================================

enum AgentKind {
  ASSISTANT
  OPERATOR
  DEV
}

enum AgentRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

/// Préférence de modèle IA par organisation et par catégorie de génération.
/// mode AUTO = l'orchestrateur choisit (fiabilité observée + coût);
/// mode FORCED = provider+model imposés par l'admin.
model AIModelPreference {
  id             String @id @default(cuid())
  organizationId String
  /// 'TEXT' | 'IMAGE' | 'VIDEO'
  category       String
  /// 'AUTO' | 'FORCED'
  mode           String @default("AUTO")
  provider       String?
  model          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([organizationId, category])
}

/// Garde-fous de l'agent par organisation : budget mensuel et interrupteur.
/// L'agent REFUSE d'invoquer un modèle au-delà du budget — décision journalisée.
model AgentPolicy {
  id                    String  @id @default(cuid())
  organizationId        String  @unique
  /// Budget IA mensuel en cents USD (AIRequest + AgentRun). 0 = agent désactivé.
  monthlyCostCentsLimit Int     @default(2000)
  enabled               Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentRun {
  id             String         @id @default(cuid())
  organizationId String
  userId         String?
  kind           AgentKind
  status         AgentRunStatus @default(PENDING)
  title          String?
  input          Json           @default("{}")
  output         Json           @default("{}")
  messages       Json           @default("[]")
  inputTokens    Int?
  outputTokens   Int?
  costCents      Int?
  startedAt      DateTime?
  finishedAt     DateTime?
  errorMessage   String?        @db.Text

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  tasks        AgentTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, kind, status])
  @@index([userId])
}

model AgentTask {
  id           String  @id @default(cuid())
  agentRunId   String
  order        Int
  toolName     String
  input        Json    @default("{}")
  output       Json?
  durationMs   Int?
  success      Boolean @default(true)
  errorMessage String? @db.Text

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([agentRunId])
}

enum IntegrationProvider {
  CANVA
  GOOGLE_DRIVE
  SLACK
  NOTION
  FIGMA
  HUBSPOT
  STRIPE
  LATE // Zernio (ex-Late) — passerelle de publication
  GMAIL // OAuth Google (gmail.send) — envoi des campagnes email
}

// Generic OAuth/API connection for any third-party service the platform integrates with.
// Tokens are AES-256-GCM encrypted at rest. Tied to either an org (shared) or a user.
model UserIntegration {
  id              String              @id @default(cuid())
  organizationId  String
  userId          String? // null = org-shared connection
  brandId         String? // null = connexion "organisation" (repli) ; sinon dédiée à cette marque
  provider        IntegrationProvider
  externalUserId  String? // provider's own user id
  displayName     String?
  accessTokenEnc  String              @db.Text
  refreshTokenEnc String?             @db.Text
  scope           String?
  expiresAt       DateTime?
  metadata        Json                @default("{}")
  active          Boolean             @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand?       @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Contrainte d'origine conservée : la modifier exige --accept-data-loss au
  // db push, et les NULL étant distincts en Postgres elle ne contraint de
  // toute façon pas les lignes org-wide — l'anti-doublon réel est applicatif
  // (findFirst incluant brandId avant create/update).
  @@unique([organizationId, provider, userId])
  @@index([organizationId, provider])
  @@index([brandId])
}

// =================================================================
// MARKETING STRATEGY (AI-generated, validated, executable)
// =================================================================

enum StrategyStatus {
  DRAFT // generated, not validated
  VALIDATED // user approved
  IN_EXECUTION
  ARCHIVED
}

enum StrategyItemStatus {
  PROPOSED // suggested by AI
  APPROVED // user OK'd
  REJECTED // user rejected
  IN_PROGRESS // being turned into real Post/Campaign
  EXECUTED // linked to a real Post/Campaign now
  ARCHIVED
}

enum StrategyItemKind {
  CONTENT_PILLAR
  POST_IDEA
  CAMPAIGN_IDEA
  AD_IDEA
  EMAIL_IDEA
  REEL_IDEA
  EXPERIMENT
  PARTNERSHIP
  MILESTONE
}

model MarketingStrategy {
  id               String         @id @default(cuid())
  organizationId   String
  brandId          String
  title            String
  status           StrategyStatus @default(DRAFT)
  horizon          String? // "30d" | "90d" | "12mo"
  generatedByModel String?
  // Full structured strategy JSON (objectives, pillars, swot, target_audience, kpis, etc.)
  strategy         Json           @default("{}")
  validatedAt      DateTime?
  validatedById    String?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  validatedBy  User?              @relation("StrategyValidator", fields: [validatedById], references: [id], onDelete: SetNull)
  items        StrategyItem[]
  pipelineRuns BrandPipelineRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([brandId])
}

model StrategyItem {
  id            String             @id @default(cuid())
  strategyId    String
  order         Int                @default(0)
  kind          StrategyItemKind
  status        StrategyItemStatus @default(PROPOSED)
  title         String
  description   String             @db.Text
  // platform suggestion, format suggestion, schedule hint
  platform      String?
  format        String?
  suggestedDate DateTime?
  hashtags      String[]
  cta           String?
  // when executed, link to the real entity
  postId        String?
  campaignId    String?
  metadata      Json               @default("{}")

  strategy MarketingStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([strategyId, status])
}

model AgentSchedule {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  cronExpression String
  enabled        Boolean   @default(true)
  promptTemplate String    @db.Text
  config         Json      @default("{}")
  lastRunAt      DateTime?
  nextRunAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([enabled, nextRunAt])
}

// =================================================================
// BRAND ONBOARDING PIPELINE
// =================================================================

enum BrandPipelineStatus {
  RUNNING
  AWAITING_ADMIN
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum BrandPipelineStep {
  CREATE_BRAND
  ENRICH_PROFILE
  VALIDATE_PROFILE
  GENERATE_STRATEGY
  VALIDATE_STRATEGY_ITEMS
  EXECUTE_ITEMS
  DONE
}

enum BrandPipelineFieldStatus {
  PENDING
  PROPOSED
  EDITED
  APPROVED
  REJECTED
}

model BrandPipelineRun {
  id                   String              @id @default(cuid())
  organizationId       String
  brandId              String?
  startedById          String
  agentRunId           String?
  strategyId           String?
  horizon              String              @default("90d")
  language             String              @default("fr")
  status               BrandPipelineStatus @default(RUNNING)
  step                 BrandPipelineStep   @default(CREATE_BRAND)
  seed                 Json                @default("{}")
  fieldStates          Json                @default("{}")
  itemStates           Json                @default("{}")
  executionLog         Json                @default("[]")
  trace                Json                @default("[]")
  adminNotes           String?             @db.Text
  approvedProfileAt    DateTime?
  approvedProfileById  String?
  approvedStrategyAt   DateTime?
  approvedStrategyById String?
  completedAt          DateTime?
  failureReason        String?             @db.Text

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand              Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  startedBy          User               @relation("BrandPipelineStarter", fields: [startedById], references: [id], onDelete: Cascade)
  approvedProfileBy  User?              @relation("BrandPipelineProfileApprover", fields: [approvedProfileById], references: [id], onDelete: SetNull)
  approvedStrategyBy User?              @relation("BrandPipelineStrategyApprover", fields: [approvedStrategyById], references: [id], onDelete: SetNull)
  strategy           MarketingStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([brandId])
  @@index([startedById])
  @@index([status, step])
}

// =================================================================
// INBOX — Social Interactions & Auto-Reply Rules
// =================================================================

model SocialInteraction {
  id              String               @id @default(cuid())
  organizationId  String
  brandId         String?
  socialAccountId String?
  postId          String?
  externalId      String               @unique
  platform        SocialPlatform
  type            InteractionType
  threadId        String?
  content         String               @db.Text
  fromHandle      String
  fromName        String?
  fromAvatarUrl   String?
  fromIsVerified  Boolean              @default(false)
  sentiment       InteractionSentiment @default(UNKNOWN)
  sentimentScore  Float?
  status          InteractionStatus    @default(NEW)
  assignedToId    String?
  repliedAt       DateTime?
  repliedById     String?
  replyContent    String?              @db.Text
  isAutoReplied   Boolean              @default(false)
  rawData         Json                 @default("{}")
  receivedAt      DateTime             @default(now())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand         Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  post          Post?          @relation(fields: [postId], references: [id], onDelete: SetNull)
  assignedTo    User?          @relation("InteractionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  repliedBy     User?          @relation("InteractionReplier", fields: [repliedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([brandId])
  @@index([socialAccountId])
  @@index([postId])
  @@index([receivedAt])
}

model AutoReplyRule {
  id                   String                 @id @default(cuid())
  organizationId       String
  brandId              String?
  enabled              Boolean                @default(false)
  allowedSentiments    InteractionSentiment[]
  allowedTypes         InteractionType[]
  customPromptFragment String?                @db.Text
  minSentimentScore    Float                  @default(0.3)
  maxReplyLength       Int                    @default(280)
  requireApproval      Boolean                @default(true)
  dailyCap             Int                    @default(20)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand?       @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([brandId])
}

// =================================================================
// REPORTING — White-label reports & scheduled report generation
// =================================================================

enum ReportStatus {
  DRAFT
  GENERATING
  READY
  FAILED
}

enum ReportPeriod {
  LAST_7_DAYS
  LAST_30_DAYS
  LAST_90_DAYS
  LAST_12_MONTHS
  LAST_MONTH
  LAST_QUARTER
  CUSTOM
}

enum ReportFrequency {
  ONCE
  WEEKLY
  MONTHLY
  QUARTERLY
}

model Report {
  id             String       @id @default(cuid())
  organizationId String
  brandId        String? // null = all brands in org
  title          String
  status         ReportStatus @default(DRAFT)
  period         ReportPeriod @default(LAST_30_DAYS)
  periodStart    DateTime?
  periodEnd      DateTime?
  // which sections to include
  sections       String[] // ['overview','engagement','top-posts','platforms','competitors','ai-summary']
  // white-label branding
  whiteLabel     Json         @default("{}") // { logoUrl, primaryColor, accentColor, footerText, agencyName }
  // generated artifacts
  data           Json         @default("{}") // the computed report data (KPIs, charts data, etc.)
  aiSummary      String?      @db.Text
  pdfUrl         String? // stored PDF url (or null if generated on-the-fly)
  generatedAt    DateTime?
  errorMessage   String?      @db.Text
  createdById    String?
  scheduleId     String?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  schedule     ReportSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([brandId])
  @@index([scheduleId])
}

model ReportSchedule {
  id             String          @id @default(cuid())
  organizationId String
  brandId        String?
  title          String
  frequency      ReportFrequency @default(MONTHLY)
  period         ReportPeriod    @default(LAST_30_DAYS)
  sections       String[]
  whiteLabel     Json            @default("{}")
  recipients     String[] // emails to send the PDF to
  enabled        Boolean         @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  reports      Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([enabled, nextRunAt])
}

// =================================================================
// SOCIAL LISTENING — Brand mention tracking, sentiment & alerts
// =================================================================

model MentionWatch {
  id              String          @id @default(cuid())
  organizationId  String
  brandId         String?
  name            String
  keywords        String[] // terms to track
  excludeKeywords String[] // negative filter
  sources         MentionSource[] // which sources to poll
  enabled         Boolean         @default(true)
  minRelevance    Float           @default(0.4)
  alertOnNegative Boolean         @default(true)
  alertOnSpike    Boolean         @default(true)
  slackWebhookUrl String?
  lastPolledAt    DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  mentions     BrandMention[]
  alerts       MentionAlert[]

  @@index([organizationId, enabled])
  @@index([brandId])
}

model BrandMention {
  id              String           @id @default(cuid())
  organizationId  String
  brandId         String?
  watchId         String
  source          MentionSource
  externalId      String // dedup key (url or platform id)
  url             String?
  authorHandle    String?
  authorName      String?
  title           String?
  content         String           @db.Text
  sentiment       MentionSentiment @default(UNKNOWN)
  sentimentScore  Float?
  relevanceScore  Float?
  reach           Int?
  engagementCount Int?
  language        String?
  status          MentionStatus    @default(NEW)
  rawData         Json             @default("{}")
  publishedAt     DateTime?
  ingestedAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  watch        MentionWatch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@unique([watchId, externalId])
  @@index([organizationId, status])
  @@index([brandId])
  @@index([sentiment])
  @@index([ingestedAt])
}

model MentionAlert {
  id               String        @id @default(cuid())
  organizationId   String
  brandId          String?
  watchId          String
  type             AlertType
  severity         AlertSeverity @default(WARNING)
  title            String
  message          String        @db.Text
  mentionIds       String[]
  acknowledged     Boolean       @default(false)
  acknowledgedById String?
  createdAt        DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  watch        MentionWatch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@index([organizationId, acknowledged])
  @@index([brandId])
}

/// Éditeur nodal — un graphe réutilisable Brief → Texte → Image → Publication.
/// Le graphe est stocké tel quel (nœuds + liens) et validé par les contrats
/// partagés `src/lib/contracts/flow.ts`, côté client comme côté serveur.
model ContentFlow {
  id             String    @id @default(cuid())
  organizationId String
  brandId        String?
  name           String
  graph          Json
  lastRunAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, updatedAt])
}
