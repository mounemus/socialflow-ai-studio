{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "regions": ["cdg1"],
  "crons": [
    {
      "path": "/api/cron/agent-tick",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/strategy-review",
      "schedule": "0 7 * * 1"
    }
  ]
}
